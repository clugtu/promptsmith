{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://promptsmith.example.com/character-schema.json",
  "title": "PromptSmith Character Database Schema",
  "description": "JSON schema for character databases used with create_image.py",
  "type": "object",
  "required": ["characters"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "imports": {
      "type": "object",
      "description": "External file references",
      "properties": {
        "generic_render_rules": {
          "type": "string",
          "description": "Path to generic rendering rules JSON"
        },
        "style_rules": {
          "type": "string",
          "description": "Path to style-specific rules JSON"
        },
        "pose_library": {
          "type": "string",
          "description": "Path to pose library JSON (required if using pose_library_ref)"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "File metadata",
      "properties": {
        "title": {"type": "string"},
        "version": {"type": "string"},
        "description": {"type": "string"},
        "created": {"type": "string", "format": "date"},
        "source": {"type": "string"}
      }
    },
    "thematic_rules": {
      "type": "object",
      "description": "Shared thematic rules applied to all characters",
      "properties": {
        "description": {"type": "string"},
        "theme": {"type": "string"},
        "character_archetype": {"type": "string"},
        "prompt_snippet": {"type": "string"},
        "forms": {
          "type": "object",
          "description": "Form definitions (e.g., werewolf forms)",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {"type": "string"},
              "anatomy": {"type": "string"},
              "prompt_snippet": {"type": "string"}
            }
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "description": "Array of character definitions",
      "items": {
        "$ref": "#/definitions/character"
      }
    }
  },
  "definitions": {
    "character": {
      "type": "object",
      "required": ["id", "name", "character_base"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique character ID (sequential, no gaps)",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "description": "Character name (human-readable, used for lookups)"
        },
        "archetype": {
          "type": "string",
          "description": "Character archetype/role classification"
        },
        "figure_type": {
          "type": "string",
          "description": "Body plan/anatomy type for pose compatibility validation",
          "enum": ["bipedal_humanoid", "quadrupedal", "facultatively_bipedal", "multi_limbed"],
          "default": "bipedal_humanoid"
        },
        "visual_notes": {
          "type": "string",
          "description": "Visual details and appearance notes"
        },
        "proportions": {
          "type": "string",
          "description": "Body proportions and build description"
        },
        "character_base": {
          "type": "string",
          "description": "Main character description used as base prompt"
        },
        "equipment": {
          "type": "array",
          "description": "Equipment carried by character (simple format)",
          "items": {"type": "string"}
        },
        "prop_definitions": {
          "type": "object",
          "description": "Reusable prop definitions that can be referenced",
          "additionalProperties": {"type": "string"}
        },
        "tags": {
          "type": "object",
          "description": "Character tags (gender, age, etc.)",
          "properties": {
            "gender": {
              "type": "string",
              "enum": ["male", "female", "other"]
            },
            "age": {
              "type": "string",
              "enum": ["child", "teen", "adult", "older", "elder", "ancient"]
            },
            "trope": {"type": "string"}
          }
        },
        "pose": {
          "$ref": "#/definitions/pose_definition",
          "description": "Single pose (for single-pose characters)"
        },
        "poses": {
          "type": "array",
          "description": "Multiple poses (for multi-pose characters)",
          "items": {
            "$ref": "#/definitions/pose_definition"
          }
        }
      },
      "oneOf": [
        {"required": ["pose"]},
        {"required": ["poses"]}
      ]
    },
    "pose_definition": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Pose ID (when in poses array)",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "description": "Pose name (used for lookups)"
        },
        "description": {
          "type": "string",
          "description": "Short pose description"
        },
        "pose_library_ref": {
          "type": "string",
          "description": "Reference to pose in pose_library.json (preferred)"
        },
        "pose_details": {
          "type": "string",
          "description": "Pose-specific character details (expression, posture adjustments, etc.)"
        },
        "prompt": {
          "type": "string",
          "description": "Inline full pose prompt (use when not using pose_library_ref)"
        },
        "camera_rotation": {
          "type": "integer",
          "description": "Camera rotation angle in degrees (optional, defaults to 45)",
          "minimum": 0,
          "maximum": 360,
          "default": 45
        },
        "equipment_override": {
          "type": "array",
          "description": "Override equipment for this specific pose",
          "items": {"type": "string"}
        },
        "thematic_snippet": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ],
          "description": "Thematic additions for this pose"
        }
      },
      "oneOf": [
        {"required": ["pose_library_ref"]},
        {"required": ["prompt"]}
      ]
    }
  }
}
